#!/usr/bin/env bash
# tmux-track-badge — mirror feldd-cc's 4 Track-LED assignments (the SP-1 front row, the 4 MRU
# sessions) into ~/.claude/agent-tracks, AND feldd-cc's live state into ~/.claude/feldd-status,
# and print a session's track badge for the status bar.
#   (no arg)   → just refresh the caches if they're stale (>2s)
#   <session>  → refresh + print that session's badge  [N]  (tmux format), dimmed when feldd-cc
#                isn't actually driving the box; else nothing
# feldd-status is one word: live (daemon up + SP-1 link up) | nodevice (daemon up, box offline)
# | offline (daemon down). The switcher reads both files directly. Cached so /config is hit ≤2s.
set -uo pipefail
f="$HOME/.claude/agent-tracks"
sf="$HOME/.claude/feldd-status"
now=$(date +%s); mt=$(stat -f %m "$f" 2>/dev/null || echo 0)
if [ $(( now - mt )) -ge 2 ]; then
  resp=$(curl -s -m 1 http://localhost:9200/config 2>/dev/null)
  if [ -n "$resp" ]; then
    status=$(printf '%s' "$resp" | python3 -c "
import sys,json
try: d=json.load(sys.stdin)
except Exception: print('nodevice'); sys.exit(0)
l=d.get('link') or {}
print('live' if l.get('up') else 'nodevice')
" 2>/dev/null || printf nodevice)
    out=$(printf '%s' "$resp" | python3 -c "
import sys,json
try: d=json.load(sys.stdin)
except Exception: sys.exit(0)
b=d.get('board') or []
print('\n'.join('%d\t%s'%(i+1,b[i]['name']) for i in range(min(4,len(b))) if b[i] and b[i].get('name')))
" 2>/dev/null)
    printf '%s\n' "$out" > "$f.tmp" && mv "$f.tmp" "$f"
  else
    status=offline
    touch "$f" 2>/dev/null                # daemon down → keep last track map, just mark offline
  fi
  printf '%s\n' "$status" > "$sf.tmp" 2>/dev/null && mv "$sf.tmp" "$sf" 2>/dev/null
fi
sess="${1:-}"; [ -n "$sess" ] || exit 0
tr=$(awk -F'\t' -v s="$sess" '$2==s{print $1; exit}' "$f" 2>/dev/null)
[ -n "$tr" ] || exit 0
if [ "$(cat "$sf" 2>/dev/null || echo live)" = live ]; then
  printf '#[fg=colour230,bold] [%s]#[default]' "$tr"     # SP-1 driving → bright badge
else
  printf '#[fg=colour240] [%s]#[default]' "$tr"          # feldd-cc offline/no device → dim badge
fi
exit 0
