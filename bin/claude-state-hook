#!/bin/bash
# claude-state-hook — records the current tmux session's Claude agent state for the
# tmux status bar, AND (BUILD 1) is the single writer that runs the verify gate on Stop.
# Wired as a Claude Code hook (see ~/.claude/settings.json). Reads the hook JSON payload
# on stdin; keys state by tmux session name.
#
# WHY the gate lives HERE and not in a second parallel Stop hook: multiple hooks on one
# event run in PARALLEL, unordered, all to completion, and THIS script is the SOLE writer of
# ~/.claude/agent-state/<sess>. Verify is slow (~100s); the state write is fast (<1s). A
# separate gate would let the fast state write land `done` before this turn's verify finishes
# -> a green LED on a red tree. Race-free requires ONE process that knows the verdict AND
# writes state AND sets the block/allow exit atomically -> this Stop branch, which calls the
# `falken-verify` helper synchronously and then writes state + exits 2-or-0 itself.
[ -n "$TMUX_PANE" ] || exit 0                                   # only meaningful inside tmux
payload=$(cat)
ev=$(printf '%s' "$payload" | grep -o '"hook_event_name":"[^"]*"' | head -1 | cut -d'"' -f4)
sess=$(tmux display -pt "$TMUX_PANE" '#{session_name}' 2>/dev/null) || exit 0
[ -n "$sess" ] || exit 0
dir="$HOME/.claude/agent-state"; mkdir -p "$dir"; f="$dir/$sess"

# --- Falken verify-gate scratch (OUTSIDE agent-state so the board never mis-reads it) ---
CDIR="$HOME/.claude/falken"
TRIES_DIR="$CDIR/verify-tries"     # per-session retry counter
RED_DIR="$CDIR/verify-red"         # per-sess "verify is red" reason marker
VERIFYING_DIR="$CDIR/verifying"    # per-sess in-flight lock (guards parallel Notification demote)
TOOL_DIR="$CDIR/tool-inflight"     # per-sess dir of markers, one per tool call currently RUNNING
BGWAIT_DIR="$CDIR/bg-wait"         # per-sess seal: a Stop SAW background work; holds until a clean Stop
TOOL_STALE_MIN=360                 # a marker older than this (minutes) is ignored: orphaned, not open
CAP=3                              # our OWN bound (<8 so it fires before any rumored built-in cap)
# rm -rf below takes this path, so the session name is sanitized to a fixed alphabet first: a
# tmux session may contain a slash, which would otherwise let "$TOOL_DIR/$sess" escape into a
# parent (a session literally named "/" would resolve td to TOOL_DIR itself and wipe every
# session's markers). A cksum suffix disambiguates names that sanitize identically (a/b vs a_b):
# without it, tool_clear from one such session would rm -rf the OTHER session's live markers --
# under-reporting depth, the unsafe direction.
tdkey="$(printf '%s' "$sess" | tr -c 'A-Za-z0-9_.-' '_').$(printf '%s' "$sess" | cksum | cut -d' ' -f1)"
td="$TOOL_DIR/$tdkey"
bmark="$BGWAIT_DIR/$tdkey"

# --- in-flight tool depth -------------------------------------------------------------
# WHY: an idle Notification only means "no hook events for ~60s", which is equally true when the
# agent was INTERRUPTED (state frozen at 'working') and when it is merely BLOCKED on a slow tool --
# a long build, a test run, a sleep. PreToolUse fires once when the tool starts and Stop does not
# fire until the whole turn ends, so from this script's side those two cases are indistinguishable,
# and the Notification branch below used to resolve BOTH to `done`: a false green while a shell
# command was still running. Depth makes "a tool is open" a fact to consult instead of a guess.
# SELF-HEAL: every turn boundary (UserPromptSubmit / Stop / SessionStart / SessionEnd) clears the
# file, and a file older than TOOL_STALE reads as 0, so a dropped PostToolUse cannot pin a session
# at 'working' forever. Both fallbacks degrade to the OLD behaviour, never to something worse.
# ONE MARKER FILE PER OPEN TOOL, never a counter. Hooks for parallel tool calls run as separate
# concurrent processes, so a counter would be an unlocked read-modify-write: two PreToolUse hooks
# both read 0, both write 1, and the first PostToolUse then writes 0 while the second tool is still
# running -- reproducing the exact false-green this change exists to kill. Creating a uniquely-named
# file and deleting an arbitrary one are both atomic, so no lock is needed. Every remaining race
# resolves toward "one marker too many", i.e. the LED stays `working` slightly too long, which is
# the safe direction; the old failure was a false `done`.
# If the marker cannot be written (unwritable scratch dir, full disk), fall back to a sentinel in
# the state dir that tool_depth also honours. Silently returning 0 here would mean "no tool open"
# during a live tool -> false `done`. The sentinel is cleared by tool_clear like any other marker.
tool_open() {
  if mkdir -p "$td" 2>/dev/null && : > "$td/$(date +%s)-$$-${RANDOM}" 2>/dev/null; then return 0; fi
  : > "$dir/.$tdkey.tool" 2>/dev/null
  return 0
}
tool_close() { local m; m=$(ls -1 "$td" 2>/dev/null | head -1); [ -n "$m" ] && rm -f "$td/$m" 2>/dev/null; return 0; }
tool_clear() { rm -rf "$td" 2>/dev/null; rm -f "$dir/.$tdkey.tool" 2>/dev/null; return 0; }
# Depth counts only markers newer than TOOL_STALE_MIN. The window is deliberately HOURS, not
# minutes: a tool that legitimately runs long (a subagent, a workflow, a background task) must never
# age out into a false `done`, and an orphaned marker costs nothing because every turn boundary
# clears the whole directory anyway. If find itself fails (unreadable dir, no find), report 1 ->
# treat the session as still working. Every failure mode here resolves to `working`, never `done`.
tool_depth() {
  [ -f "$dir/.$tdkey.tool" ] && { echo 1; return; }   # marker-write fallback: assume a tool is open
  [ -d "$td" ] || { echo 0; return; }
  local out n
  # find's EXIT STATUS is captured, not just its output: a failing find prints nothing, and piping
  # straight into `wc -l` would launder that into a perfectly valid "0" -- i.e. fail toward a false
  # `done`, the exact bug class this whole change exists to remove. Any failure reports 1 instead.
  out=$(find "$td" -type f -mmin -"$TOOL_STALE_MIN" 2>/dev/null) || { echo 1; return; }
  n=$(printf '%s' "$out" | grep -c . 2>/dev/null)
  case "$n" in ''|*[!0-9]*) echo 1 ;; *) echo "$n" ;; esac
}

# --- background tasks from the Stop payload (authoritative) ------------------------------
# Claude Code's Stop (and SubagentStop) input carries `background_tasks`: one entry per
# in-flight task (shell, monitor, workflow, subagent, MCP task, ...), and an empty array when
# nothing is in flight. This is the clean signal the 2026-07-21 investigation (FALKEN.md) asked
# for; it covers what the badge scrape cannot see reliably (a running workflow may put nothing in
# the mode bar, saved-script and resumed workflows). Prints the entry count, or nothing when the
# field is absent (older Claude Code, registry unreachable) or unparseable, in which case the
# caller falls back to the badge scrape. `session_crons` is deliberately ignored: a scheduled
# wakeup is not work in flight, and a session idling until its next /loop tick is `done`.
bg_task_count() {
  command -v python3 >/dev/null 2>&1 || return 0
  printf '%s' "$payload" | python3 -c 'import json,sys
try:
    d=json.load(sys.stdin)
except Exception:
    sys.exit(0)
bt=d.get("background_tasks") if isinstance(d,dict) else None
if isinstance(bt,list): print(len(bt))' 2>/dev/null
}

# --- background-work badge --------------------------------------------------------------
# Claude Code renders status-bar badges ("· 1 shell", "· 2 background tasks", "· 1 MCP task
# still running", "· 1 workflow", "· 1 monitor") ONLY while such background work is running; they vanish the
# moment it completes (verified: absent on idle panes). `monitor` added 2026-10-27: a
# session waiting on a Monitor watch read `done` because the badge list predated it. The
# "← N agent" badge is NOT background work (it shows on idle sessions too) and is not matched. This is the clean signal the
# 2026-07-21 investigation (FALKEN.md backlog) said did not exist -- it ships with newer CC.
# The leading middle-dot anchors the match to badge syntax, so ordinary prose in a captured
# line ("I started 2 background tasks") cannot match. Consulted by BOTH turn-end writers
# (Stop's STEP 1.5 and the idle-Notification demote) so the two parallel writers cannot
# disagree into a false green. Returns: 0 badge present · 1 pane read clean, no badge ·
# 2 pane unreadable (caller picks the safe direction).
bg_badge() {
  local pane
  pane=$(tmux capture-pane -t "$TMUX_PANE" -p 2>/dev/null) || return 2
  [ -n "$pane" ] || return 2
  # Structural line rules, not just a substring: (1) the delimited badge form is accepted ONLY
  # in the TUI chrome, i.e. the lines below the INPUT BOX. The input box is positively
  # identified: a block between two borders whose first line starts with the prompt ("❯", or
  # "!" in shell mode, then a space or end of line: tmux trims the space after an empty
  # prompt). A border starts at column 0 with a run of ten or more "─" (it may carry a label
  # after the run); a draft line such as "  ─ heading" inside the box is not one. A
  # rule alone is not enough — permission dialogs draw rules too, and their body can quote
  # badge-looking text. Assistant prose sits above the box, so "Summary · 2 background tasks ·
  # completed" in a message body cannot match. Any rule AFTER the box (a dialog) voids the
  # chrome. The chrome can be more than one line: a running workflow adds a progress row under
  # the mode bar (2026-10-27), so "last non-empty line" alone missed the badge. With no input
  # box on screen, fall back to the last non-empty line. Badges may share one slot,
  # comma-joined ("· 1 shell, 1 monitor ·"); the pattern accepts a comma ONLY between badge
  # items, so the whole "·"-delimited segment must be a badge list. (2) Elsewhere in the last 3
  # lines, only the spinner form, which ends in the literal "still running" AND carries the
  # middle-dot count prefix — prose would have to reproduce "· N <badge> still running"
  # verbatim at end-of-line, at which point a brief `working` over-report is the safe
  # direction anyway.
  local lines chrome
  lines=$(printf '%s\n' "$pane" | grep -v '^[[:space:]]*$')
  chrome=$(printf '%s\n' "$lines" | awk '
    /^──────────/ {                      # a border: closes the input box, or voids the chrome
      if (inbox) { found = 1; buf = "" } else { found = 0 }
      inbox = 0; first = 1; next
    }
    {
      if (first) { inbox = ($0 ~ /^(❯|!)( |$)/); first = 0 }
      if (found) buf = buf $0 "\n"
    }
    END { if (found) printf "%s", buf }')
  [ -n "$chrome" ] || chrome=$(printf '%s\n' "$lines" | tail -1)
  local kind='[0-9]+ (shells?|MCP tasks?|background tasks?|workflows?|monitors?)'
  printf '%s\n' "$chrome" \
    | grep -qE "· $kind(, $kind)*( still running)?( ·|\$)" && return 0
  printf '%s\n' "$lines" | tail -3 \
    | grep -qE '· [0-9]+ (shells?|MCP tasks?|background tasks?|workflows?|monitors?) still running$' && return 0
  return 1
}

# All gate scratch is keyed by the tmux SESSION NAME (one pane = one agent = one session), the
# same key as the state file. Keying the counter by session_id instead would let wrap/human-gate
# clear the red marker but NOT the counter (they know $sess, not $sid) -> a stale count survives.
ckey="$sess"
cf="$TRIES_DIR/$ckey"
rmark="$RED_DIR/$sess"
vlock="$VERIFYING_DIR/$sess"

# `wrapped` is a deliberate park (Opt-w / SP-1 Vol-). Keep it STICKY: only an explicit human
# re-engage (UserPromptSubmit) un-wraps it, or SessionEnd clears it. Background events
# (PreToolUse / PermissionRequest / Notification / Stop) must NOT resurrect a parked session --
# otherwise a stray Stop flips wrapped->done and it pops back onto a Track.
if [ "$(cat "$f" 2>/dev/null)" = wrapped ]; then
  case "$ev" in
    UserPromptSubmit|SessionEnd) : ;;    # fall through (un-wrap on re-engage / clear on end)
    *) exit 0 ;;                          # stay wrapped through every background event
  esac
fi
case "$ev" in
  UserPromptSubmit)                                             # you gave it a task
    echo working > "$f"
    rm -f "$cf" "$rmark" "$bmark" 2>/dev/null; tool_clear ;;    # fresh human turn -> reset gate counter + tool markers + bg seal
  PreToolUse)        echo working > "$f"; tool_open ;;        # actively using tools (clears stale needs after you answer)
  PostToolUse|PostToolUseFailure)
    # A tool finished. Close it and leave state alone: the turn is still running, and Stop is the
    # branch that decides `done`. Writing state here would race the verify gate.
    tool_close ;;
  PermissionRequest) echo needs   > "$f" ;;                     # explicit approval gate
  Notification)
    # Claude Code fires Notification for (a) a tool-permission request, or (b) the prompt sitting
    # idle ~60s. (a) is a real "needs you". (b) means the session is at the prompt, NOT actively
    # generating -- so if it's still marked 'working', it has actually STOPPED (e.g. you
    # INTERRUPTED it: an interrupt fires no Stop hook, freezing the state at 'working') and is
    # waiting for you -> demote to done. Only touches 'working', so a session that legitimately
    # went idle/done, or a parked one, is left alone.
    msg=$(printf '%s' "$payload" | grep -o '"message":"[^"]*"' | head -1 | cut -d'"' -f4)
    case "$msg" in
      *permission*|*Permission*|*approval*|*Approval*) echo needs > "$f" ;;
      *)
        # SEAL: an Esc-interrupt mid-red-retry can freeze state at 'working', and this idle
        # Notification (a PARALLEL claude-state-hook, possibly firing DURING the blocking verify)
        # would demote it to 'done' on a still-red tree. If a verify-red marker or an in-flight
        # verify lock exists for this session, demote to 'needs' instead -> never a false green.
        if [ "$(cat "$f" 2>/dev/null)" = working ]; then
          if [ "$(tool_depth)" -gt 0 ]; then
            :                                                     # tool still open -> idle means BLOCKED, not stopped
          elif [ -f "$bmark" ] || bg_badge; then
            # bg seal OR live badge -> BLOCKED on background work, not stopped. The persistent
            # seal (written by the Stop that saw the badge) closes the TOCTOU where the work
            # completes between that Stop's pane snapshot and this one: only a later CLEAN Stop
            # (which runs the verify gate) or a fresh human prompt releases it.
            :
          elif [ -f "$rmark" ] || [ -f "$vlock" ]; then echo needs > "$f"
          else echo done > "$f"; fi
        fi
        ;;
    esac
    ;;
  Stop)
    # ---- STEP 1: HUMAN-GATE WINS ----
    # An AskUserQuestion / permission prompt pauses for you but fires no needs-hook — it lands as a
    # Stop. If the pane's LAST lines show such a prompt, it's really "needs you" (blink), not done.
    # A pending human decision must NEVER be force-continued away by a verify block.
    if tmux capture-pane -t "$TMUX_PANE" -p 2>/dev/null | grep -v '^[[:space:]]*$' | tail -4 \
         | grep -qiE 'Enter to select.*(navigate|cancel)|Do you want to proceed'; then
      echo needs > "$f"                                          # question on screen → blink
      rm -f "$cf" "$rmark" 2>/dev/null
      exit 0
    fi

    # ---- STEP 1.5: BACKGROUND WORK OUTLIVES THE TURN (2026-08-25) ----
    # The old premise here ("turn over -> nothing can still be open") predates async background
    # work: a turn now ends while a run_in_background shell, an async MCP task (e.g. a Sol
    # review), or a background workflow is still in flight, and CC re-wakes the session when it
    # completes. Writing `done` at that stop was the board's recurring false-green.
    # bg_badge is the primary signal. Badge present -> working. Badge legibly ABSENT on a
    # readable pane -> any remaining depth markers are stale (their PostToolUse was dropped) ->
    # clear them and fall through to the verify gate, preserving the self-heal guarantee. Pane
    # unreadable -> fall back to depth markers, failing toward `working`, never a false `done`.
    # The idle-Notification demote makes the SAME bg_badge check, so the two parallel writers
    # cannot disagree into a false green. The verify gate is DEFERRED to the final stop (no
    # pending work), so it checks the finished tree; the re-wake's Stop re-enters this branch.
    nbg=$(bg_task_count)
    case "$nbg" in
      '') bg_badge; bgrc=$? ;;                  # no payload list -> scrape the badge (fallback)
      0)  bgrc=1 ;;                             # payload says nothing in flight
      *)  bgrc=0 ;;                             # payload lists in-flight work
    esac
    if [ "$bgrc" = "0" ] || { [ "$bgrc" = "2" ] && [ "$(tool_depth)" -gt 0 ]; }; then
      # Persistent seal FIRST: the parallel Notification writer honors it even if the badge
      # vanishes right after this snapshot. If the seal cannot be written AND read back, fall
      # back to tool_open's sentinel chain — tool_depth honors it, and Notification checks
      # depth before the seal, so the protection holds without a silent degrade.
      if ! { mkdir -p "$BGWAIT_DIR" 2>/dev/null && : > "$bmark" 2>/dev/null && [ -f "$bmark" ]; }; then
        tool_open
      fi
      echo working > "$f"                                        # waiting on background work, not done
      exit 0
    fi
    # Clean pane: do NOT release the seal or the depth markers yet. Both stay until THIS
    # process exits — i.e. after whichever terminal write below (un-gated done, GREEN done,
    # needs, RED working) has landed — so the parallel Notification writer can never demote in
    # any gap between this re-evaluation and the gate's verdict, INCLUDING the corner where the
    # seal write failed and tool_open's depth sentinel is carrying the protection instead.
    # STEP 4's vlock trap re-arms this same cleanup. Self-heal is preserved: everything still
    # clears by process exit, and UserPromptSubmit/SessionEnd clear it independently.
    trap 'rm -f "$bmark" 2>/dev/null; tool_clear' EXIT

    # ---- STEP 2: OPT-IN (repo-root walk + falken key presence) ----
    # Walk UP from the payload cwd to the first dir containing .git (the repo boundary). The walk
    # itself needs NO python3 (pure filesystem), so a missing interpreter cannot silently un-gate.
    cwd=$(printf '%s' "$payload" | grep -o '"cwd":"[^"]*"' | head -1 | cut -d'"' -f4)
    root=""
    wd="$cwd"
    while [ -n "$wd" ] && [ "$wd" != "/" ]; do
      if [ -e "$wd/.git" ]; then root="$wd"; break; fi
      wd=$(dirname "$wd")
    done
    gated=0
    if [ -n "$root" ] && [ -f "$root/package.json" ]; then
      if command -v python3 >/dev/null 2>&1; then
        hasf=$(python3 -c 'import json,sys
try:
    d=json.load(open(sys.argv[1]))
except Exception:
    print("0"); sys.exit(0)
print("1" if isinstance(d,dict) and "falken" in d else "0")' "$root/package.json" 2>/dev/null)
        [ "$hasf" = "1" ] && gated=1
      else
        # python3 unavailable: grep fallback so "can't tell" does not resolve to a false done.
        # Matches a real key ("falken":) but not a dependency name like "falken-utils".
        if grep -q '"falken"[[:space:]]*:' "$root/package.json" 2>/dev/null; then gated=1; fi
      fi
    fi
    if [ "$gated" != "1" ]; then
      echo done > "$f"                                          # un-gated repo / cockpit -> finished
      exit 0
    fi

    # stop_hook_active: parsed via python3 (never grep an unquoted bool). BACKSTOP allow-signal
    # only — it is NEVER used to authorize a block. Empty if python3 absent (backstop just no-ops).
    sha=$(printf '%s' "$payload" | python3 -c 'import json,sys
try:
    d=json.load(sys.stdin)
except Exception:
    print("0"); sys.exit(0)
print("1" if d.get("stop_hook_active") is True else "0")' 2>/dev/null)

    # ---- STEP 3: COUNTER, INCREMENT-FIRST ----
    # Increment + record BEFORE verify runs, so the bound holds even if verify never returns
    # (the hook timeout kills us, but the count already advanced -> the next stop moves toward CAP).
    # Unlike the old design we DO still run verify at the cap (see STEP 4): the increment-first
    # write is only a hang backstop, never a reason to skip the final check.
    mkdir -p "$TRIES_DIR" "$RED_DIR" "$VERIFYING_DIR" 2>/dev/null
    n=$(cat "$cf" 2>/dev/null); case "$n" in ''|*[!0-9]*) n=0 ;; esac
    n=$((n + 1))
    if ! (echo "$n" > "$cf") 2>/dev/null; then
      # cannot RECORD a block -> an unrecorded block is unbounded -> FAIL OPEN, surface.
      echo needs > "$f"; rm -f "$rmark" 2>/dev/null
      printf 'falken gate: could not write retry counter; failing open to needs.\n' >&2
      exit 0
    fi
    rb=$(cat "$cf" 2>/dev/null)
    if [ "$rb" != "$n" ]; then
      echo needs > "$f"                                         # counter untrusted -> fail open
      printf 'falken gate: retry counter readback mismatch; failing open to needs.\n' >&2
      exit 0
    fi

    # BACKSTOP: CC says we are already in a forced-continue chain (stop_hook_active) yet the counter
    # looks fresh -> it was lost/reset -> do NOT emit an unbounded block; surface instead.
    if [ "$sha" = "1" ] && [ "$n" -le 1 ]; then
      rm -f "$cf" 2>/dev/null; echo needs > "$f"
      printf 'falken gate: stop_hook_active but counter reset; failing open to needs.\n' >&2
      exit 0
    fi

    # ---- STEP 4: VERIFY (runs on EVERY attempt, including the cap attempt) ----
    # Resolve falken-verify by ABSOLUTE path — hooks can run with a PATH that excludes ~/bin, and a
    # bare "command not found" (rc 127) would be misread as RED and block spuriously. If the helper
    # is genuinely missing, fail SAFE: surface as needs (never a false green, never a forced loop).
    FV=$(command -v falken-verify 2>/dev/null)
    [ -x "$FV" ] || FV="$HOME/bin/falken-verify"
    [ -x "$FV" ] || FV="$HOME/bnjmn/falken/bin/falken-verify"
    if [ ! -x "$FV" ]; then
      rm -f "$cf" 2>/dev/null; echo needs > "$f"
      printf 'falken gate: falken-verify helper not found; surfacing as needs (cannot verify).\n' >&2
      exit 0
    fi
    : > "$vlock" 2>/dev/null
    trap 'rm -f "$vlock" "$bmark" 2>/dev/null; tool_clear' EXIT   # vlock, bg seal, and depth markers all
                                                                  # live until THIS process exits (after the
                                                                  # state write below), sealing the
                                                                  # false-green window end to end.
    out=$("$FV" "$root" 2>&1); rc=$?

    # Respect an explicit HUMAN signal set DURING the ~100s verify window: if the user parked the
    # session (wrapped) or a permission gate landed (needs) while verify ran, do NOT clobber it and
    # do NOT force-continue past the human. Leave the state, allow the stop.
    cur=$(cat "$f" 2>/dev/null)
    if [ "$cur" = wrapped ] || [ "$cur" = needs ]; then
      exit 0
    fi

    case "$rc" in
      0)                                                        # GREEN
        rm -f "$cf" "$rmark" 2>/dev/null
        echo done > "$f"
        exit 0 ;;
      2)                                                        # falken-verify could not classify
        # The caller already confirmed the falken key, so a NOOP here means the helper could not
        # read it (e.g. no python3 in ITS env). Fail SAFE to needs, never to a false done.
        rm -f "$cf" 2>/dev/null; echo needs > "$f"
        printf 'falken gate: falken-verify could not classify the repo; surfacing as needs.\n' >&2
        exit 0 ;;
      3)                                                        # infra/env (watchdog, npm/op missing,
                                                                # unresolved env, no lb test surface)
        printf 'verify could not run (infra/env)\n' > "$rmark"
        rm -f "$cf" 2>/dev/null; echo needs > "$f"
        printf '%s\n' "$out" | tail -c 2048 >&2
        printf '\n--- falken gate: verify could not run (infra/env, not a code failure); surfacing as needs. ---\n' >&2
        exit 0 ;;
      *)                                                        # RED (genuine code failure)
        # Record the red marker BEFORE anything else, so a parallel idle-Notification never
        # false-greens this working state (the Notification SEAL keys on exactly this marker).
        printf 'verify red (attempt %s/%s)\n' "$n" "$CAP" > "$rmark"
        if [ "$n" -ge "$CAP" ]; then
          # Cap reached and STILL red (we DID verify this attempt): stop blocking, surface it.
          rm -f "$cf" 2>/dev/null
          echo needs > "$f"                                     # longest-waiting ✋, no more forced loops
          tmux display-message "falken: $sess verify red after $n tries" 2>/dev/null
          printf '%s\n' "$out" | tail -c 2048 >&2
          printf '\n--- falken gate: verify still RED after %s attempts; surfacing as needs, no longer blocking. ---\n' "$n" >&2
          exit 0
        fi
        echo working > "$f"                                     # LED lit, NOT done; agent keeps fixing
        printf '%s\n' "$out" | tail -c 4096 >&2
        printf '\n--- falken gate: verify RED (attempt %s/%s). Fix the above, then finish; the gate re-checks on stop. ---\n' "$n" "$CAP" >&2
        exit 2 ;;
    esac
    ;;
  SessionStart) echo idle > "$f"; tool_clear ;;
  SessionEnd)
    rm -f "$f" "$cf" "$rmark" "$vlock" "$bmark" 2>/dev/null; tool_clear ;; # clear state + all gate scratch
esac
exit 0
