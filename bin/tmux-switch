#!/usr/bin/env bash
# tmux-switch — fzf "hot switcher" across ALL tmux sessions, showing live agent state.
# Bound to Opt-s (primary) and C-a Tab (fallback). Runs inside `tmux display-popup -E`.
#   ↑/↓ move · type to filter · Enter jump · Ctrl-X kill (confirm) · Esc cancel
# Modes: --list (emit rows, used by fzf reload) · --kill <sess> (confirm+kill) · default (interactive)
# Sort: ✋ needs (longest-waiting first) → ● working → ✓ done → ○ idle → ■ wrapped.
# bash 3.2 safe (no mapfile / no declare -A).
set -uo pipefail
self="$0"
dir="$HOME/.claude/agent-state"

human() {  # seconds -> Xs / Xm / Xh
  local s=$1
  if   [ "$s" -lt 60 ];   then echo "${s}s"
  elif [ "$s" -lt 3600 ]; then echo "$((s/60))m"
  else echo "$((s/3600))h"; fi
}

list() {
  local now cur R G D Y W DIM RST s st age f mt icon col lab rk wait mark disp tracked FELDD tcol active
  now=$(date +%s); cur=$(tmux display -p '#{session_name}' 2>/dev/null)
  active=$(cat "$HOME/.claude/falken-switcher-filter" 2>/dev/null | tr -d '\n')   # state filter (empty = show all)
  FELDD=$(cat "$HOME/.claude/feldd-status" 2>/dev/null || echo live)     # live | nodevice | offline
  tcol=$'\033[38;5;230m'; [ "$FELDD" = live ] || tcol=$'\033[38;5;240m'  # dim Track badges when SP-1 isn't driven
  R=$'\033[38;5;167m'; G=$'\033[38;5;78m'; D=$'\033[38;5;178m'   # done = amber (review me)
  Y=$'\033[38;5;180m'; W=$'\033[38;5;240m'; DIM=$'\033[2m'; RST=$'\033[0m'
  while IFS= read -r s; do
    [ -n "$s" ] || continue
    st="idle"; age=0; tracked=0; f="$dir/$s"
    if [ -f "$f" ]; then
      tracked=1; st=$(cat "$f" 2>/dev/null); [ -n "$st" ] || st="idle"
      mt=$(stat -f %m "$f" 2>/dev/null || echo "$now"); age=$(( now - mt ))
      [ "$st" = needs ] && [ "$age" -gt 28800 ] && st="idle"
    fi
    if [ -n "$active" ]; then case " $active " in *" $st "*) : ;; *) continue ;; esac; fi   # apply state filter
    case "$st" in
      needs)   icon="✋"; col="$R"; lab="needs  "; rk=0 ;;
      working) icon="●";  col="$G"; lab="working"; rk=1 ;;
      done)    icon="✓";  col="$D"; lab="done   "; rk=2 ;;
      idle)    icon="○";  col="$Y"; lab="idle   "; rk=3 ;;
      wrapped) icon="■";  col="$W"; lab="wrapped"; rk=4 ;;
      *)       icon="·";  col="$Y"; lab="$st";      rk=5 ;;
    esac
    if [ "$tracked" = 1 ]; then wait=$(human "$age"); else wait=""; fi
    mark=""; [ "$s" = "$cur" ] && mark=" ${DIM}←here${RST}"
    tb=$(awk -F'\t' -v x="$s" '$2==x{print $1; exit}' "$HOME/.claude/agent-tracks" 2>/dev/null)
    badge=""; [ -n "$tb" ] && badge="$tcol"" [$tb]"$'\033[0m'   # SP-1 Track LED 1-4 (dim when feldd-cc offline)
    disp=$(printf '%s%s %s%s  %-4s  %s%s%s%s%s' "$col" "$icon" "$lab" "$RST" "$wait" "$col" "$s" "$RST" "$badge" "$mark")
    if [ -n "$tb" ]; then grp=0; key="$tb"; else grp=1; key="$rk"; fi   # SP-1-tracked pinned to top, in track order
    printf '%d\t%d\t%d\t%s\t%s\n' "$grp" "$key" "$age" "$disp" "$s"
  done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null) \
    | sort -t "$(printf '\t')" -k1,1n -k2,2n -k3,3nr | cut -f4,5
}

case "${1:-}" in
  --list) list; exit 0 ;;
  --kill)
    s="${2:-}"; [ -n "$s" ] || exit 0
    printf '\n  kill session "%s"?  [y/N] ' "$s"
    read -rsn1 a; echo
    case "$a" in y|Y) tmux kill-session -t "$s" 2>/dev/null ;; esac
    exit 0 ;;
  --wrap-toggle)
    s="${2:-}"; [ -n "$s" ] || exit 0
    # ■ wrapped ⇄ ✓ done (parked ↔ un-parked)
    if [ "$(cat "$dir/$s" 2>/dev/null)" = wrapped ]; then echo done > "$dir/$s"; else echo wrapped > "$dir/$s"; fi
    exit 0 ;;
  --prompt)  # emit the fzf prompt string for a given filter (state words) -> chip prompt
    flt="${2:-}"; chips=""
    for s in $flt; do case "$s" in
      needs) chips="${chips}✋" ;; working) chips="${chips}●" ;; done) chips="${chips}✓" ;;
      wrapped) chips="${chips}■" ;; idle) chips="${chips}○" ;; esac
    done
    if [ -n "$chips" ]; then printf 'jump %s › ' "$chips"; else printf 'jump › '; fi
    exit 0 ;;
  --cycle-filter)  # ^F: step the state filter through presets (all → needs → … → triage → all)
    FF="$HOME/.claude/falken-switcher-filter"; cur=$(cat "$FF" 2>/dev/null | tr -d '\n')
    case "$cur" in
      "")           next="needs" ;;
      needs)        next="working" ;;
      working)      next="done" ;;
      done)         next="wrapped" ;;
      wrapped)      next="needs done" ;;   # triage
      "needs done") next="" ;;
      *)            next="" ;;             # any custom f: filter → back to all
    esac
    printf '%s' "$next" > "$FF"
    printf 'reload(%s --list)+change-prompt(%s)' "$self" "$("$self" --prompt "$next")"
    exit 0 ;;
  --enter-action)  # ⏎: if the query is `f:states`, set the filter; else jump (accept)
    q="${2:-}"
    case "$q" in
      f:*)
        spec="${q#f:}"; out=""
        for tok in $spec; do                     # prefix-match each token to state name(s)
          for stname in needs working done wrapped idle; do
            case "$stname" in "$tok"*) out="$out $stname" ;; esac
          done
        done
        out=$(printf '%s\n' $out | awk 'NF && !seen[$0]++' | tr '\n' ' ' | sed 's/ *$//')
        FF="$HOME/.claude/falken-switcher-filter"; printf '%s' "$out" > "$FF"
        printf 'clear-query+reload(%s --list)+change-prompt(%s)' "$self" "$("$self" --prompt "$out")"
        ;;
      *) printf 'accept' ;;
    esac
    exit 0 ;;
esac

TAB=$(printf '\t')
"$(dirname "$self")/tmux-track-badge" >/dev/null 2>&1 || true   # refresh SP-1 track map (cached)
# Full-height dynamic list (fills the popup); small FALKEN ascii wordmark as the footer.
# alt-s also aborts → Opt-s toggles the switcher open/closed (Esc always closes too).
W1='█▀▀▀ ▄▀▀▄ █    █ ▄▀ █▀▀▀ █▄ █'
W2='█▀▀  █▀▀█ █    █▀▄  █▀▀  █ ▀█'
W3='▀    ▀  ▀ ▀▀▀▀ ▀  ▀ ▀▀▀▀ ▀  ▀'
# feldd-cc live/offline status, tucked to the LOWER-RIGHT of the FALKEN wordmark (its baseline row).
FSTAT=""
if [ -f "$HOME/.claude/feldd-status" ]; then
  case "$(cat "$HOME/.claude/feldd-status" 2>/dev/null)" in
    live)     FSTAT=$'\033[38;5;78m● feldd-cc live\033[0m' ;;
    nodevice) FSTAT=$'\033[38;5;178m◐ feldd-cc · SP-1 disconnected\033[0m' ;;
    *)        FSTAT=$'\033[38;5;240m○ feldd-cc offline\033[0m' ;;
  esac
fi
FOOTER="$W1"$'\n'"$W2"$'\n'"$W3"
[ -n "$FSTAT" ] && FOOTER="$W1"$'\n'"$W2"$'\n'"$W3""  $FSTAT"
HDR='↑↓ move · type=search · ^F cycle filter · f:working⏎ set · ⏎ jump · ^W wrap · ^X kill · esc'
INITP=$("$self" --prompt "$(cat "$HOME/.claude/falken-switcher-filter" 2>/dev/null | tr -d '\n')")   # remembered filter
pick=$("$self" --list | fzf --ansi --no-sort --reverse \
    --delimiter="$TAB" --with-nth=1 \
    --height=100% --border=rounded --color='border:240,footer:178,prompt:178,pointer:178,info:246' \
    --footer="$FOOTER" --footer-border=line \
    --prompt="$INITP" --pointer='▶' --info=inline \
    --header="$HDR" \
    --bind 'alt-s:abort' \
    --bind "ctrl-f:transform($self --cycle-filter)" \
    --bind "enter:transform($self --enter-action {q})" \
    --bind "ctrl-w,alt-w:execute-silent($self --wrap-toggle {2})+reload($self --list)" \
    --bind "ctrl-x:execute($self --kill {2})+reload($self --list)")

[ -n "${pick:-}" ] || exit 0
sess=$(printf '%s' "$pick" | cut -f2)
[ -n "$sess" ] && tmux switch-client -t "$sess"
