#!/usr/bin/env bash
# tmux-agent-state — Falken's agent board for the tmux status bar.
#   N sess   ✋ needs (red, named, wait-time, longest-first)   ● working (green, named)
#   ✓ done (dim, count)   ■ wrapped (dim, count)   + a stacked state bar.
# PERF: one python pass over the agent-state dir (was a per-file cat+stat+basename fork loop —
# ~66 forks for 22 sessions, the 204ms status-bar hog). Now 1 tmux call + 1 python = 2 forks.
total=$(tmux list-sessions 2>/dev/null | wc -l | tr -d ' ')
exec python3 - "$total" <<'PY'
import os, sys, time
total = sys.argv[1] if len(sys.argv) > 1 else ""
d = os.path.expanduser("~/.claude/agent-state")
now = time.time()
needs = []; working = []; done_n = wrapped_n = idle_n = 0
try:
    entries = sorted(os.listdir(d))            # sorted → same order as the old bash glob
except OSError:
    entries = []
for name in entries:
    p = os.path.join(d, name)
    try:
        st = open(p).read().strip()
        mt = os.stat(p).st_mtime
    except OSError:
        continue
    age = int(now - mt)
    if st == "needs" and age > 28800:          # stale needs → idle (matches switcher)
        st = "idle"
    if st == "needs":     needs.append((age, name))
    elif st == "working": working.append(name)
    elif st == "done":    done_n += 1
    elif st == "wrapped": wrapped_n += 1
    elif st == "idle":    idle_n += 1

def human(s):
    return f"{s}s" if s < 60 else (f"{s//60}m" if s < 3600 else f"{s//3600}h")

needs.sort(reverse=True)                        # longest-waiting first
needs_disp = [f"{nm} {human(a)}" for a, nm in needs]

parts = []
# stacked state bar (red=needs · green=working · amber=done · grey=idle · dk-grey=wrapped),
# cumulative rounding so the segments always sum to exactly bw cells.
bar_total = len(needs) + len(working) + done_n + idle_n + wrapped_n
if bar_total > 0:
    bw = 20; blk = "█"
    bn = [len(needs), len(working), done_n, idle_n, wrapped_n]
    bcol = [167, 78, 178, 245, 240]
    acc = drawn = 0; bar = ""
    for k in range(5):
        acc += bn[k]
        target = (acc * bw + bar_total // 2) // bar_total
        cells = target - drawn; drawn = target
        if cells > 0:
            bar += f"#[fg=colour{bcol[k]}]" + blk * cells
    parts.append(bar + "#[default]")

if total and total != "0":
    parts.append(f"#[fg=colour245]{total} sess#[default]")
nc = len(needs_disp)
if nc:
    txt = " ".join(needs_disp[:4]) + (f" +{nc-4}" if nc > 4 else "")
    parts.append(f"#[fg=colour167,bold]✋ {nc} {txt}#[default]")
wc = len(working)
if wc:
    txt = " ".join(working[:3]) + (f" +{wc-3}" if wc > 3 else "")
    parts.append(f"#[fg=colour78]● {wc} {txt}#[default]")
if done_n:    parts.append(f"#[fg=colour178,bold]✓ {done_n}#[default]")
if wrapped_n: parts.append(f"#[fg=colour240]■ {wrapped_n}#[default]")

sys.stdout.buffer.write("  ".join(parts).encode("utf-8"))   # byte-exact UTF-8, locale-independent
PY
