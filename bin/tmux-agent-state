#!/usr/bin/env bash
# tmux-agent-state — agent cockpit for the tmux status bar (bash 3.2 safe).
#   N sess   ✋ needs (red, named, wait-time, longest-first)   ● working (green, named)
#   ✓ done (dim, count)   ■ wrapped (dim, count)
dir="$HOME/.claude/agent-state"
now=$(date +%s)
total=$(tmux list-sessions 2>/dev/null | wc -l | tr -d ' ')

needs_line=(); working=(); done_n=0; wrapped_n=0; idle_n=0
if [ -d "$dir" ]; then
  for f in "$dir"/*; do
    [ -e "$f" ] || continue
    name=$(basename "$f")
    st=$(cat "$f" 2>/dev/null)
    mt=$(stat -f %m "$f" 2>/dev/null || echo 0)
    age=$(( now - mt ))
    [ "$age" -gt 28800 ] && continue                 # >8h stale → skip
    case "$st" in
      needs)     needs_line+=("$age $name") ;;
      working)   working+=("$name") ;;
      done)      done_n=$(( done_n + 1 )) ;;
      wrapped)   wrapped_n=$(( wrapped_n + 1 )) ;;
      idle)      idle_n=$(( idle_n + 1 )) ;;   # counted for the state bar only, not a chip
    esac
  done
fi

human(){ if [ "$1" -lt 60 ]; then echo "${1}s"; elif [ "$1" -lt 3600 ]; then echo "$(( $1/60 ))m"; else echo "$(( $1/3600 ))h"; fi; }

# needs sorted by age DESC (longest waiting first) → "name Xm"
needs_disp=()
if [ ${#needs_line[@]} -gt 0 ]; then
  while IFS=' ' read -r a nm; do
    [ -n "$nm" ] && needs_disp+=("$nm $(human "$a")")
  done < <(printf '%s\n' "${needs_line[@]}" | sort -rn)
fi

# stacked state bar: proportion of every session in each state (fills to 100%),
# colored red=needs · green=working · amber=done · grey=idle · dk-grey=wrapped.
needs_n=${#needs_line[@]}; work_n=${#working[@]}
bar_total=$(( needs_n + work_n + done_n + idle_n + wrapped_n ))
bar=""
if [ "$bar_total" -gt 0 ]; then
  bw=20
  bn=("$needs_n" "$work_n" "$done_n" "$idle_n" "$wrapped_n")
  bcol=(203 150 214 245 240)
  acc=0; drawn=0; k=0
  while [ "$k" -lt 5 ]; do
    acc=$(( acc + ${bn[$k]} ))
    target=$(( (acc * bw + bar_total / 2) / bar_total ))   # rounded cumulative → sum stays = bw
    cells=$(( target - drawn )); drawn=$target
    if [ "$cells" -gt 0 ]; then
      seg=""; j=0; while [ "$j" -lt "$cells" ]; do seg="$seg█"; j=$(( j + 1 )); done
      bar="$bar#[fg=colour${bcol[$k]}]$seg"
    fi
    k=$(( k + 1 ))
  done
  bar="$bar#[default]"
fi

parts=()
[ -n "$bar" ] && parts+=("$bar")
[ -n "$total" ] && [ "$total" -gt 0 ] && parts+=("#[fg=colour245]${total} sess#[default]")

nc=${#needs_disp[@]}
if [ "$nc" -gt 0 ]; then
  shown=("${needs_disp[@]:0:4}"); more=$(( nc - 4 ))
  txt="${shown[*]}"; [ "$more" -gt 0 ] && txt="$txt +$more"
  parts+=("#[fg=colour203,bold]✋ ${nc} ${txt}#[default]")
fi
wcnt=${#working[@]}
if [ "$wcnt" -gt 0 ]; then
  shown=("${working[@]:0:3}"); more=$(( wcnt - 3 ))
  txt="${shown[*]}"; [ "$more" -gt 0 ] && txt="$txt +$more"
  parts+=("#[fg=colour150]● ${wcnt} ${txt}#[default]")
fi
[ "$done_n" -gt 0 ] && parts+=("#[fg=colour214,bold]✓ ${done_n}#[default]")
[ "$wrapped_n" -gt 0 ] && parts+=("#[fg=colour240]■ ${wrapped_n}#[default]")

out=""; i=0
for p in "${parts[@]}"; do
  [ "$i" -gt 0 ] && out="$out  "
  out="$out$p"; i=$(( i + 1 ))
done
printf '%s' "$out"
