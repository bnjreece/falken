#!/usr/bin/env bash
# reece-help — cheat sheet for Falken, the reece.is agent board. (prefix = C-a)
b=$'\e[1m'; d=$'\e[2m'; x=$'\e[0m'
c=$'\e[38;5;178m'; g=$'\e[38;5;78m'; y=$'\e[38;5;220m'; r=$'\e[38;5;167m'; am=$'\e[38;5;178m'
# fleet-jewel rows for the FALKEN wordmark (256-color, WebSSH-safe)
L1=$'\e[38;5;78m'; L2=$'\e[38;5;178m'; L3=$'\e[38;5;167m'
cat <<EOF

${L1}   █▀▀▀ ▄▀▀▄ █    █ ▄▀ █▀▀▀ █▄ █${x}
${L2}   █▀▀  █▀▀█ █    █▀▄  █▀▀  █ ▀█${x}
${L3}   ▀    ▀  ▀ ▀▀▀▀ ▀  ▀ ▀▀▀▀ ▀  ▀${x}

  ${d}Falken · the falcon over your fleet${x}   ${b}·${x}   ${y}${b}esc or q to close${x}

  ${b}SESSIONS${x}
    ${g}cs${x} [name]        start/attach a Claude session (plays the reece splash on create)
    ${g}csd${x} [name]       same, but --dangerously-skip-permissions
    ${g}ta${x} <name> attach   ${g}tl${x} list   ${g}tk${x} <name> kill

  ${b}STATUS BAR${x} ${d}(bottom of every session)${x}
    ${c}◉ reece.is${x}      the dot turns ${r}red${x} when any session needs you
    ${r}✋ N name Xm${x}     agents blocked on you — with how long they've waited (longest first)
    ${y}● N name${x}        agents working
    ${am}✓ N${x}             done — finished, ready for your review
    ${d}■ N${x}             wrapped — you parked it (off your plate)
    ${d}N sess${x}          total tmux sessions

  ${b}KEYS${x} ${d}— Opt-letter (hold Option) = one-touch · C-a + Shift = fallback${x}
    ${g}Opt-s${x} ${d}/ C-a Tab${x}  ${b}switcher${x} — pick any session, type to filter  ${d}(inside: ^W wrap · ^X kill)${x}
    ${g}Opt-n${x} ${d}/ C-a N${x}    jump to the next session that ${r}needs you${x}  ${d}(tap again to cycle)${x}
    ${g}Opt-m${x} ${d}/ C-a D${x}    cycle ${d}✓ done${x} sessions to review yourself, oldest first ${d}(tap to cycle)${x}
    ${g}Opt-w${x}             ${b}wrap ⇄ unwrap${x} toggle for this session  ${d}(■ ⇄ ✓)${x}
    ${g}C-a W${x} ${d}/ C-a U${x}    force wrap  /  force un-wrap
    ${g}Opt-i${x} ${d}/ C-a I${x}    this help    ${g}C-a r${x}  reload tmux config

  ${b}WRAP (from a shell)${x}
    ${g}wrap${x} [name]  park    ${g}wrap -c${x} [name]  un-park    ${g}wrap -t${x} [name]  toggle

  ${b}AI TEAM${x}
    In any session, say ${y}"get Sol's take on this"${x} → Claude hands the task to
    OpenAI Codex (GPT-5.x) via the ${g}codex-runner${x} skill, on your ChatGPT Pro sub.
    Full multi-agent "Room": ${d}~/bnjmn/the-room/SPEC.md${x} (Phase 1, not built yet)

  ${b}SPLASH${x}
    ${g}reece${x}  full  ·  ${g}reece --quick${x}  short  ·  ${g}reece --loop${x}  loop

  ${b}SP-1 / feldd-cc${x} ${d}— the physical box mirrors your fleet ${x}${d}(switcher shows ${x}${g}● live${d} / ${x}${d}○ offline)${x}
    ${d}feldd-cc bridges the agent board to the SP-1 over Bluetooth. The 4 front Track${x}
    ${d}LEDs = your 4 most-recently-active sessions — the ${x}${b}[1]-[4]${x}${d} badges in the switcher.${x}

    ${b}Track LEDs${x} ${d}— what each light means${x}
      ${r}fast blink${x}   needs you
      ${y}pulse${x}        working
      ${am}solid${x}        done
      ${d}off${x}          wrapped · idle · empty (parked, or nothing there)

    ${b}Buttons${x}
      ${g}Track 1-4${x}    jump to that session
      ${g}FWD / RWD${x}    jog the triage queue — needs first, then done (oldest first)
      ${g}Vol- / Vol+${x}  ${b}wrap${x} / ${b}unwrap${x} the focused session
      ${g}Play${x}         send ${y}"continue"${x} to the focused session
      ${d}when a session asks permission:  ${x}${g}Play${x}${d} = approve · ${x}${g}Vol-${x}${d} = deny${x}

    ${b}Faders${x} ${d}(global — whole fleet)${x}
      ${g}1${x}  autopilot on/off      ${d}down = off · up = auto-continue the fleet${x}
      ${g}2${x}  autopilot duration    ${d}down = 5 min · mid = ~1 hr · up = forever${x}
      ${g}3${x}  scroll within         ${d}scrub back through the focused session's output${x}
      ${g}4${x}  scroll across         ${d}sweep a highlight over the fleet · Play to jump${x}

    ${d}config panel: ${x}${g}localhost:9200/settings${x}${d}   ·   box asleep? tap a key on it to wake${x}

  ${d}scripts: ~/bin/{reece,tmux-agent-state,tmux-reece-dot,tmux-jump-needs,wrap,reece-help}${x}
  ${d}state: ~/.claude/agent-state/   hook: ~/bin/claude-state-hook   config: ~/.tmux.conf${x}

EOF
