#!/usr/bin/env bash
# tmux-reece-dot — the reece.is "live" dot; turns RED (pulsing) when any session needs you.
# PERF: one python pass over the agent-state dir (was a per-file cat+stat fork loop, ~82ms).
exec python3 <<'PY'
import os, sys, time
d = os.path.expanduser("~/.claude/agent-state")
now = time.time()
red = False
try:
    for name in os.listdir(d):
        p = os.path.join(d, name)
        try:
            if open(p).read().strip() != "needs":
                continue
            if now - os.stat(p).st_mtime > 28800:   # stale needs → ignore
                continue
        except OSError:
            continue
        red = True
        break
except OSError:
    pass
if red:                                              # pulse bright/dim red each second
    s = "#[fg=colour167,bold]◉#[default]" if int(now) % 2 == 0 else "#[fg=colour88]◉#[default]"
else:
    s = "#[fg=colour78]◉#[default]"                  # all clear → steady green
sys.stdout.buffer.write(s.encode("utf-8"))
PY
