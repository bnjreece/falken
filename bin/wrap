#!/usr/bin/env bash
# wrap [session]      — mark a Claude session "wrapped" (parked / off your plate → ■ in the bar)
# wrap -c [session]   — un-wrap (back to ✓ done)
# wrap -t [session]   — toggle wrapped ⇄ done (Opt-w uses this: one chord, both ways)
# With no session arg, uses the current tmux session. (bash 3.2 safe)
dir="$HOME/.claude/agent-state"; mkdir -p "$dir"
mode=wrap
case "${1:-}" in
  -c|--clear|unwrap) mode=clear;  shift ;;
  -t|--toggle)       mode=toggle; shift ;;
esac
sess="${1:-$(tmux display -p '#{session_name}' 2>/dev/null)}"
if [ -z "$sess" ]; then
  echo "usage: wrap [session]      park (→ ■ wrapped)"
  echo "       wrap -c [session]   un-wrap (→ ✓ done)"
  echo "       wrap -t [session]   toggle wrapped ⇄ done"
  exit 1
fi
if [ "$mode" = toggle ]; then
  if [ "$(cat "$dir/$sess" 2>/dev/null)" = wrapped ]; then mode=clear; else mode=wrap; fi
fi
if [ "$mode" = clear ]; then
  # un-wrap to `working` (NOT `done`): a wrapped session may hide a red tree, so the next Stop
  # must RE-VERIFY before it is allowed to show ✓. Clear BOTH gate-scratch files keyed by $sess
  # (the red marker AND the retry counter) so the promised re-verify actually starts from scratch.
  echo working > "$dir/$sess"
  rm -f "$HOME/.claude/falken/verify-red/$sess" "$HOME/.claude/falken/verify-tries/$sess" 2>/dev/null
  msg="un-wrapped (re-verifies on next stop): $sess"
else echo wrapped > "$dir/$sess"; msg="parked (wrapped): $sess"; fi
if command -v tmux >/dev/null 2>&1 && [ -n "${TMUX:-}" ]; then tmux display-message "$msg" 2>/dev/null; fi
echo "$msg"
