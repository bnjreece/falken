#!/usr/bin/env bash
# falken-reap — retire piled-up MCP servers in long-running fleet sessions.
#
# THE PROBLEM
# Every agent invocation spawns its MCP server set over stdio, and a stdio
# server lives exactly as long as its client holds the pipe. Nothing times out,
# because the protocol has no idle concept. Clients that keep a session open for
# days therefore accumulate sets: one Codex process observed here was 16 days
# old and held 31 copies of one MCP server, ~43 MB each, doing nothing.
#
# WHY NOT "KILL THE IDLE ONES"
# The obvious heuristic — reap servers with no CPU time — was measured and does
# NOT work. On this machine a LIVE Codex session's servers showed 0.01-0.53s of
# cumulative CPU while 10-day-old abandoned ones showed 0.7s. These processes
# are near-idle even when connected, so CPU cannot tell live from abandoned.
#
# WHY THIS IS REPORT-ONLY
# It was built to retire surplus servers, and Sol's review killed that on
# evidence. Two findings, both decisive:
#
#   1. Killing a connected stdio server does NOT transparently recover. Codex
#      0.153.3's reinitialization path handles HTTP session-expiry, not a
#      terminated stdio subprocess, and its connection manager has no
#      replace-and-retry branch - calls fail until an explicit reconnect or a
#      restart. Anthropic reproduced the same class of failure on Claude Code
#      2.1.233: the server exits, the NEXT call respawns and succeeds, and the
#      one after that fails "No such tool available".
#
#   2. "Newest is the live one" is unsound. Main client starts server A;
#      subagents later start B, C, D and leak them when they finish; the main
#      client still uses A. Keeping the newest 3 kills A and preserves all
#      three leaks - exactly inverted.
#
# An earlier draft argued the surplus was "abandoned by construction" because
# each invocation spawns a fresh pair. That inference was wrong: the client
# spawns a new pair AND retains the old ones. Spawn-per-invocation says nothing
# about whether the old connections are still referenced.
#
# So this measures and reports. Reclaiming the memory means ending the CLIENT
# (restart the session, resume the conversation), which is a decision for a
# human looking at these numbers.
#
# usage:
#   falken-reap                 # per-session MCP pile-up report
#   falken-reap --keep 2        # count surplus past 2 per (session, server) [default 3]
#   falken-reap --grace 60      # ignore processes younger than 60m [default 30]
#   falken-reap --json          # machine-readable, for the board
set -uo pipefail

keep=3; grace=30; json=0
while [ $# -gt 0 ]; do
  case "$1" in
    --apply)
      # Kept as an explicit error rather than silently ignored: anyone reaching
      # for it deserves to know WHY it is gone, not to think it worked.
      printf 'falken-reap: --apply was removed. Killing a connected stdio MCP\n' >&2
      printf '  server does not recover transparently (Codex 0.153.3 has no\n' >&2
      printf '  replace-and-retry for a dead stdio child; Claude Code loses the\n' >&2
      printf '  tools a call later). Reclaim by ending the CLIENT instead:\n' >&2
      printf '  restart the session and resume the conversation.\n' >&2
      exit 2 ;;
    --keep)  keep="${2:?--keep needs a number}"; shift ;;
    --grace) grace="${2:?--grace needs minutes}"; shift ;;
    --json)  json=1 ;;
    -h|--help)
      sed -n '/^# usage:/,/^set -uo/p' "$0" | sed 's/^# \{0,1\}//; $d'
      exit 0 ;;
    *) printf 'falken-reap: unknown arg %s\n' "$1" >&2; exit 2 ;;
  esac
  shift
done

# `--keep 0` would select every process and a negative value would trigger
# Python's negative slicing, quietly inverting the whole report.
case "$keep" in ''|*[!0-9]*) printf 'falken-reap: --keep must be a positive integer\n' >&2; exit 2 ;; esac
case "$grace" in ''|*[!0-9]*) printf 'falken-reap: --grace must be a non-negative integer\n' >&2; exit 2 ;; esac
[ "$keep" -ge 1 ] || { printf 'falken-reap: --keep must be >= 1\n' >&2; exit 2; }

exec python3 - "$keep" "$grace" "$json" <<'PY'
import os, sys, json as J, subprocess, collections

KEEP, GRACE_MIN, JSON = int(sys.argv[1]), int(sys.argv[2]), sys.argv[3] == "1"
STATE_DIR = os.path.expanduser("~/.claude/agent-state")

# Matched on the command line because the process NAME is useless here: almost
# everything reports as `node`.
#
# CAVEAT, and it matters for reading the output: this counts PROCESSES, not
# servers. One logical server can be a wrapper plus a vendored child plus
# workers, all matching the same needle, so a single healthy server can show up
# as several rows. Treat the numbers as pile-up pressure, not a server census.
KINDS = (
    ("codex mcp-server",  "codex"),
    ("node_repl",         "node_repl"),
)
# Machine-specific servers stay out of this public repo: list them in
# ~/.falken/reap-kinds, one per line as "<command-line needle> <label>" (the
# label is the last word; # starts a comment). A missing file is fine. They are
# matched before the generic kinds above.
try:
    with open(os.path.expanduser("~/.falken/reap-kinds"), encoding="utf-8", errors="replace") as fh:
        _local = [l.strip().rsplit(None, 1) for l in fh if l.strip() and not l.lstrip().startswith("#")]
    KINDS = tuple((n, k) for n, k in (p for p in _local if len(p) == 2)) + KINDS
except OSError:
    pass

def kind_of(cmd):
    for needle, label in KINDS:
        if needle in cmd:
            return label
    return None

def etime_seconds(t):
    """ps ELAPSED -> seconds. Formats: MM:SS, HH:MM:SS, D-HH:MM:SS."""
    days = 0
    if "-" in t:
        d, t = t.split("-", 1)
        days = int(d)
    bits = [int(x) for x in t.split(":")]
    while len(bits) < 3:
        bits.insert(0, 0)
    h, m, s = bits
    return days * 86400 + h * 3600 + m * 60 + s

# --- real footprint, not RSS ---
# These servers sit idle for days, so the OS pages them out and `ps rss` reports
# a fraction of what they actually hold: 248 leaked servers measured 118 MB
# resident but ~10 GB of footprint, which is precisely why swap was pinned.
# Reporting RSS would make the win look 80x smaller than it is. One `top` call
# is the cheapest source of phys_footprint; if it fails we fall back to RSS and
# say so rather than quietly reporting the wrong number.
FOOT, FOOT_OK = {}, False
try:
    top = subprocess.run(["top", "-l", "1", "-n", "600", "-stats", "pid,mem"],
                         capture_output=True, text=True, timeout=25).stdout
    for line in top.splitlines():
        f = line.split()
        if len(f) != 2 or not f[0].isdigit():
            continue
        tok = f[1].rstrip("+-")
        unit, val = tok[-1], tok[:-1]
        try:
            v = float(val)
        except ValueError:
            continue
        # "512B" is 512 BYTES. Treating a bare B as megabytes overstated a
        # tiny process by six orders of magnitude.
        scale = {"B": 1 / 1048576, "K": 1 / 1024, "M": 1.0, "G": 1024.0}.get(unit)
        if scale is None:
            continue
        FOOT[int(f[0])] = v * scale
    FOOT_OK = bool(FOOT)
except Exception:
    FOOT_OK = False

# top -n is a HEAD of the process list, so a candidate outside it silently fell
# back to RSS while the report still claimed footprint_source=top. Track
# coverage per candidate and say so.
MISSED = set()

def mb_of(pid, rss_kb):
    if pid in FOOT:
        return FOOT[pid]
    MISSED.add(pid)
    return rss_kb / 1024

# --- one ps pass; building the tree by hand beats N pgrep forks ---
ps = subprocess.run(
    ["ps", "-Ao", "pid=,ppid=,etime=,rss=,command="],
    capture_output=True, text=True).stdout
kids = collections.defaultdict(list)
proc = {}
for line in ps.splitlines():
    f = line.strip().split(None, 4)
    if len(f) < 5:
        continue
    try:
        pid, ppid, rss = int(f[0]), int(f[1]), int(f[3])
    except ValueError:
        continue
    kids[ppid].append(pid)
    proc[pid] = {"ppid": ppid, "age": etime_seconds(f[2]), "rss": rss, "cmd": f[4]}

def descendants(root):
    seen, stack = set(), [root]
    while stack:
        p = stack.pop()
        if p in seen:
            continue
        seen.add(p)
        stack.extend(kids.get(p, []))
    return seen

# --- map every process to the tmux session that owns it ---
# splitlines(), NOT split(): a session named "work fleet" splits on the space
# and gets attributed to "fleet", which then reads the WRONG state file.
# rsplit on the delimiter for the same reason - the name may contain "|".
panes = subprocess.run(
    ["tmux", "list-panes", "-a", "-F", "#{session_name}|#{pane_pid}"],
    capture_output=True, text=True).stdout.splitlines()
owner, shared = {}, set()
for line in panes:
    line = line.strip()
    if "|" not in line:
        continue
    sess, pane_pid = line.rsplit("|", 1)
    try:
        pane_pid = int(pane_pid)
    except ValueError:
        continue
    for pr in descendants(pane_pid):
        prev = owner.get(pr)
        if prev is None:
            owner[pr] = sess
        elif prev != sess:
            # A linked/shared pane appears under several sessions. Last-writer
            # -wins silently misattributed these; flag instead of guessing.
            shared.add(pr)

def state_of(sess):
    try:
        return open(os.path.join(STATE_DIR, sess)).read().strip()
    except OSError:
        return "unknown"

# --- group: (session, kind) -> [processes], newest first ---
groups = collections.defaultdict(list)
for pid, p in proc.items():
    k = kind_of(p["cmd"])
    if not k:
        continue
    sess = owner.get(pid)
    if not sess:
        continue          # not in the fleet; not ours to manage
    groups[(sess, k)].append((p["age"], pid, p["rss"]))

grace_s = GRACE_MIN * 60
plan, skipped = [], []
for (sess, kind), rows in sorted(groups.items()):
    rows.sort()                       # youngest first: age ascending
    st = state_of(sess)
    surplus = rows[KEEP:]             # everything past the newest KEEP
    if not surplus:
        continue
    if st == "working":
        # Mid-turn. A retire here could pull a server out from under a live
        # call, and the win is only memory - it can wait for the next sweep.
        skipped.append({"session": sess, "kind": kind, "state": st,
                        "surplus": len(surplus),
                        "mb": round(sum(mb_of(r[1], r[2]) for r in surplus))})
        continue
    for age, pid, rss in surplus:
        if age < grace_s:
            continue
        plan.append({"session": sess, "kind": kind, "pid": pid,
                     "age_h": round(age / 3600, 1), "mb": round(mb_of(pid, rss), 1)})

freed = round(sum(p["mb"] for p in plan))

if JSON:
    print(J.dumps({
        "report_only": True,
        "keep": KEEP, "grace_min": GRACE_MIN,
        "surplus": plan, "skipped_working": skipped,
        "surplus_mb": freed,
        # per-candidate truth, not a global claim: anything outside top's head
        # fell back to RSS and is therefore understated.
        "footprint_source": "top" if FOOT_OK else "rss",
        "footprint_missed_pids": sorted(MISSED),
        "shared_pane_pids": sorted(shared),
        "counts_processes_not_servers": True,
    }, indent=2))
    sys.exit(0)

if not plan and not skipped:
    print(f"falken-reap: no pile-up (keep={KEEP}/kind/session, grace={GRACE_MIN}m)")
    sys.exit(0)

by_sess = collections.defaultdict(list)
for p in plan:
    by_sess[p["session"]].append(p)
verb = "surplus"
for sess in sorted(by_sess):
    rows = by_sess[sess]
    mb = round(sum(r["mb"] for r in rows))
    print(f"{sess:<12} {verb} {len(rows):>3} proc(s)  {mb:>6} MB  [{state_of(sess)}]")
    counts = collections.Counter(r["kind"] for r in rows)
    oldest = max(r["age_h"] for r in rows)
    print("             " + ", ".join(f"{k} x{v}" for k, v in counts.most_common())
          + f"   (oldest {oldest}h)")
for s in skipped:
    print(f"{s['session']:<12} SKIPPED  {s['surplus']:>3} {s['kind']} "
          f"({s['mb']} MB) - session is {s['state']}")
note = "" if FOOT_OK else "  [RSS fallback - understates paged-out processes]"
print(f"{'':<12} {'TOTAL':<7} {len(plan):>3} proc(s)  {freed:>6} MB{note}")
if MISSED:
    print(f"  note: {len(MISSED)} process(es) fell outside top's window; "
          f"their size is RSS and therefore understated")
if shared:
    print(f"  note: {len(shared)} process(es) sit under panes shared by more than "
          f"one session; ownership is ambiguous and they are attributed to the first")
print("  report only. To reclaim: restart the owning session and resume the")
print("  conversation - killing a connected MCP server loses its tools.")
PY
