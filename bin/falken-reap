#!/usr/bin/env bash
# falken-reap — retire piled-up MCP servers in long-running fleet sessions.
#
# THE PROBLEM
# Every agent invocation spawns its MCP server set over stdio, and a stdio
# server lives exactly as long as its client holds the pipe. Nothing times out,
# because the protocol has no idle concept. Clients that keep a session open for
# days therefore accumulate sets: one Codex process observed here was 16 days
# old and held 31 copies of one MCP server, ~43 MB each, doing nothing.
#
# WHY NOT "KILL THE IDLE ONES"
# The obvious heuristic — reap servers with no CPU time — was measured and does
# NOT work. On this machine a LIVE Codex session's servers showed 0.01-0.53s of
# cumulative CPU while 10-day-old abandoned ones showed 0.7s. These processes
# are near-idle even when connected, so CPU cannot tell live from abandoned.
#
# WHY THIS IS REPORT-ONLY
# It was built to retire surplus servers, and Sol's review killed that on
# evidence. Two findings, both decisive:
#
#   1. Killing a connected stdio server does NOT transparently recover. Codex
#      0.153.3's reinitialization path handles HTTP session-expiry, not a
#      terminated stdio subprocess, and its connection manager has no
#      replace-and-retry branch - calls fail until an explicit reconnect or a
#      restart. Anthropic reproduced the same class of failure on Claude Code
#      2.1.233: the server exits, the NEXT call respawns and succeeds, and the
#      one after that fails "No such tool available".
#
#   2. "Newest is the live one" is unsound. Main client starts server A;
#      subagents later start B, C, D and leak them when they finish; the main
#      client still uses A. Keeping the newest 3 kills A and preserves all
#      three leaks - exactly inverted.
#
# An earlier draft argued the surplus was "abandoned by construction" because
# each invocation spawns a fresh pair. That inference was wrong: the client
# spawns a new pair AND retains the old ones. Spawn-per-invocation says nothing
# about whether the old connections are still referenced.
#
# So this measures and reports. Reclaiming the memory means ending the CLIENT
# (restart the session, resume the conversation), which is a decision for a
# human looking at these numbers.
#
# usage:
#   falken-reap                 # per-session MCP pile-up report
#   falken-reap --keep 2        # count surplus past 2 per (session, server) [default 3]
#   falken-reap --grace 60      # ignore processes younger than 60m [default 30]
#   falken-reap --json          # machine-readable, for the board
set -uo pipefail

keep=3; grace=30; json=0
while [ $# -gt 0 ]; do
  case "$1" in
    --apply)
      # Kept as an explicit error rather than silently ignored: anyone reaching
      # for it deserves to know WHY it is gone, not to think it worked.
      printf 'falken-reap: --apply was removed. Killing a connected stdio MCP\n' >&2
      printf '  server does not recover transparently (Codex 0.153.3 has no\n' >&2
      printf '  replace-and-retry for a dead stdio child; Claude Code loses the\n' >&2
      printf '  tools a call later). Reclaim by ending the CLIENT instead:\n' >&2
      printf '  restart the session and resume the conversation.\n' >&2
      exit 2 ;;
    --keep)  keep="${2:?--keep needs a number}"; shift ;;
    --grace) grace="${2:?--grace needs minutes}"; shift ;;
    --json)  json=1 ;;
    -h|--help)
      sed -n '/^# usage:/,/^set -uo/p' "$0" | sed 's/^# \{0,1\}//; $d'
      exit 0 ;;
    *) printf 'falken-reap: unknown arg %s\n' "$1" >&2; exit 2 ;;
  esac
  shift
done

# `--keep 0` would select every process and a negative value would trigger
# Python's negative slicing, quietly inverting the whole report.
case "$keep" in ''|*[!0-9]*) printf 'falken-reap: --keep must be a positive integer\n' >&2; exit 2 ;; esac
case "$grace" in ''|*[!0-9]*) printf 'falken-reap: --grace must be a non-negative integer\n' >&2; exit 2 ;; esac
[ "$keep" -ge 1 ] || { printf 'falken-reap: --keep must be >= 1\n' >&2; exit 2; }

exec python3 - "$keep" "$grace" "$json" <<'PYEOF'
import os, sys, json as J, subprocess, collections

KEEP, GRACE_MIN, JSON = int(sys.argv[1]), int(sys.argv[2]), sys.argv[3] == "1"
STATE_DIR = os.path.expanduser("~/.claude/agent-state")
VALID_STATES = {"working", "needs", "done", "wrapped", "idle"}

# Matched on the command line because the process NAME is useless here: almost
# everything reports as `node`.
#
# CAVEAT, and it matters for reading the output: this counts PROCESSES, not
# servers. One logical server can be a wrapper plus a vendored child plus
# workers, all matching the same needle, so a single healthy server can show up
# as several rows and a fresh restart can recreate that exact arrangement.
# Treat the numbers as "matching processes above a threshold", never as bytes
# that are wasted or that a restart will recover.
KINDS = (
    ("codex mcp-server",  "codex"),
    ("node_repl",         "node_repl"),
)
# Machine-specific servers stay out of this public repo: list them in
# ~/.falken/reap-kinds, one per line as "<command-line needle> <label>" (the
# label is the last word; # starts a comment). A missing file is fine. They are
# matched before the generic kinds above.
try:
    with open(os.path.expanduser("~/.falken/reap-kinds"), encoding="utf-8", errors="replace") as fh:
        _local = [l.strip().rsplit(None, 1) for l in fh if l.strip() and not l.lstrip().startswith("#")]
    KINDS = tuple((n, k) for n, k in (p for p in _local if len(p) == 2)) + KINDS
except OSError:
    pass

def kind_of(cmd):
    for needle, label in KINDS:
        if needle in cmd:
            return label
    return None

def etime_seconds(t):
    """ps ELAPSED -> seconds. Formats: MM:SS, HH:MM:SS, D-HH:MM:SS."""
    days = 0
    if "-" in t:
        d, t = t.split("-", 1)
        days = int(d)
    bits = [int(x) for x in t.split(":")]
    while len(bits) < 3:
        bits.insert(0, 0)
    h, m, s = bits
    return days * 86400 + h * 3600 + m * 60 + s

def fail(msg, code=3):
    """Collection failed. This must NEVER look like a healthy empty result: a
    status bar that turns "ps died" into green is worse than no status bar."""
    if JSON:
        print(J.dumps({"ok": False, "report_only": True, "error": msg}))
    else:
        print(f"falken-reap: {msg}", file=sys.stderr)
    sys.exit(code)

# --- real footprint, not RSS ---
# These servers sit idle for days, so the OS pages them out and `ps rss` reports
# a fraction of what they hold: 248 of them measured 118 MB resident against
# ~5.4 GB of footprint, which is precisely why swap was pinned. One `top` call
# is the cheapest source of phys_footprint. top -n is a HEAD of the process
# list, so any candidate outside it falls back to RSS - and the report says
# which, per row, rather than claiming "top" if any process at all was seen.
FOOT = {}
try:
    top = subprocess.run(["top", "-l", "1", "-n", "600", "-stats", "pid,mem"],
                         capture_output=True, text=True, timeout=25).stdout
    for line in top.splitlines():
        f = line.split()
        if len(f) != 2 or not f[0].isdigit():
            continue
        tok = f[1].rstrip("+-")
        unit, val = tok[-1], tok[:-1]
        try:
            v = float(val)
        except ValueError:
            continue
        # "512B" is 512 BYTES; a bare B treated as megabytes overstated a tiny
        # process by six orders of magnitude.
        scale = {"B": 1 / 1048576, "K": 1 / 1024, "M": 1.0, "G": 1024.0}.get(unit)
        if scale is None:
            continue
        FOOT[int(f[0])] = v * scale
except Exception:
    FOOT = {}

def measure(pid, rss_kb):
    """-> (megabytes, source) so every row carries its own provenance."""
    if pid in FOOT:
        return FOOT[pid], "top"
    return rss_kb / 1024, "rss"

# --- one ps pass; building the tree by hand beats N pgrep forks ---
# subprocess.run raises OSError before there is a return code to check when
# the binary is missing or execution is denied. Route that through fail() too,
# or it is a traceback and exit 1 that breaks the JSON contract.
try:
    ps_r = subprocess.run(["ps", "-Ao", "pid=,ppid=,etime=,rss=,command="],
                          capture_output=True, text=True)
except OSError as e:
    fail(f"ps could not be launched: {e}")
if ps_r.returncode != 0 or not ps_r.stdout.strip():
    fail(f"ps failed (rc={ps_r.returncode}): {ps_r.stderr.strip() or 'no output'}")
kids = collections.defaultdict(list)
proc = {}
for line in ps_r.stdout.splitlines():
    f = line.strip().split(None, 4)
    if len(f) < 5:
        continue
    try:
        pid, ppid, rss = int(f[0]), int(f[1]), int(f[3])
    except ValueError:
        continue
    kids[ppid].append(pid)
    proc[pid] = {"ppid": ppid, "age": etime_seconds(f[2]), "rss": rss, "cmd": f[4]}

def descendants(root):
    seen, stack = set(), [root]
    while stack:
        p = stack.pop()
        if p in seen:
            continue
        seen.add(p)
        stack.extend(kids.get(p, []))
    return seen

# --- map every process to the tmux session(s) that own it ---
# splitlines(), NOT split(): a session named "work fleet" splits on the space
# and gets attributed to "fleet", which then reads the WRONG state file.
# rsplit on the delimiter for the same reason - the name may contain "|".
try:
    tm_r = subprocess.run(["tmux", "list-panes", "-a", "-F", "#{session_name}|#{pane_pid}"],
                          capture_output=True, text=True)
except OSError as e:
    fail(f"tmux could not be launched: {e}")
if tm_r.returncode != 0:
    fail(f"tmux failed (rc={tm_r.returncode}): {tm_r.stderr.strip() or 'no server?'}")
owners = collections.defaultdict(set)   # pid -> {session, ...}; a SET, on purpose
sessions = set()
for line in tm_r.stdout.splitlines():
    line = line.strip()
    if "|" not in line:
        continue
    sess, pane_pid = line.rsplit("|", 1)
    try:
        pane_pid = int(pane_pid)
    except ValueError:
        continue
    sessions.add(sess)
    for pr in descendants(pane_pid):
        owners[pr].add(sess)

# --- read each session's state ONCE, normalised, so classification and
#     display cannot disagree about what was observed ---
def read_state(sess):
    # UnicodeError too: a state file holding invalid UTF-8 raised straight
    # through OSError-only handling and took the WHOLE report down - and every
    # session is read eagerly, so an unrelated session's corrupt byte did it.
    try:
        st = open(os.path.join(STATE_DIR, sess)).read().strip()
    except (OSError, UnicodeError):
        return "unknown"
    return st if st in VALID_STATES else "unknown"
state = {s: read_state(s) for s in sessions}

# --- group: (session, kind) -> rows, then classify ---
groups = collections.defaultdict(list)
for pid, p in proc.items():
    k = kind_of(p["cmd"])
    if not k:
        continue
    own = owners.get(pid)
    if not own:
        continue                      # not in the fleet; not ours to report on
    for sess in own:                  # a shared pane lands in EVERY owner's group
        groups[(sess, k)].append((p["age"], pid, p["rss"]))

grace_s = GRACE_MIN * 60
# Four buckets. Only `surplus` is a restart candidate; the others exist so an
# ambiguous or unknowable measurement is never quietly folded into it.
surplus, skipped_working, unknown, shared = [], [], [], []
for (sess, kind), rows in sorted(groups.items()):
    rows.sort()                       # youngest first
    # Grace applies BEFORE classification, identically for every bucket. An
    # earlier draft applied it only to the non-working branch, so the same
    # four one-second-old processes were "surplus" in one state and nothing
    # in another.
    aged = [(a, pid, rss) for (a, pid, rss) in rows[KEEP:] if a >= grace_s]
    for age, pid, rss in aged:
        mb, src = measure(pid, rss)
        rec = {"session": sess, "kind": kind, "pid": pid, "state": state[sess],
               "age_h": round(age / 3600, 1), "mb": round(mb, 1), "source": src}
        if len(owners[pid]) > 1:
            # A shared pid is appended once per owner-group, then de-duped by
            # pid below. Whichever copy survives, its top-level `state` must
            # not be one arbitrary owner's - that field is what a consumer
            # keys on. The per-owner truth lives in `states`.
            rec["state"] = "shared"
            rec["owners"] = sorted(owners[pid])
            rec["states"] = {o: state[o] for o in owners[pid]}
            shared.append(rec)
        elif state[sess] == "working":
            skipped_working.append(rec)
        elif state[sess] == "unknown":
            unknown.append(rec)
        else:
            surplus.append(rec)

# de-dupe shared rows: one per pid, since it was appended under each owner
_seen = set()
shared = [r for r in shared if not (r["pid"] in _seen or _seen.add(r["pid"]))]

def source_of(rows):
    srcs = {r["source"] for r in rows}
    return "none" if not srcs else "mixed" if len(srcs) > 1 else srcs.pop()

def total_mb(rows):
    return round(sum(r["mb"] for r in rows))

if JSON:
    print(J.dumps({
        "ok": True, "report_only": True,
        "keep": KEEP, "grace_min": GRACE_MIN,
        "surplus": surplus, "surplus_mb": total_mb(surplus),
        "surplus_footprint_source": source_of(surplus),
        "skipped_working": skipped_working,
        "unknown_state": unknown,
        "shared_pane": shared,
        "counts_processes_not_servers": True,
    }, indent=2))
    sys.exit(0)

if not (surplus or skipped_working or unknown or shared):
    print(f"falken-reap: no pile-up (keep={KEEP}/kind/session, grace={GRACE_MIN}m)")
    sys.exit(0)

def block(label, rows):
    by = collections.defaultdict(list)
    for r in rows:
        by[r["session"]].append(r)
    for sess in sorted(by):
        rs = by[sess]
        kinds = collections.Counter(r["kind"] for r in rs)
        src = source_of(rs)
        srcnote = "" if src == "top" else f"  [{src}]"
        print(f"{sess:<12} {label:<9}{len(rs):>4} proc(s)  {total_mb(rs):>6} MB  "
              f"[{rs[0]['state']}]{srcnote}")
        print("             " + ", ".join(f"{k} x{v}" for k, v in kinds.most_common())
              + f"   (oldest {max(r['age_h'] for r in rs)}h)")

block("surplus", surplus)
block("working", skipped_working)
block("unknown", unknown)
if shared:
    src = source_of(shared)
    srcnote = "" if src == "top" else f"  [{src}]"
    print(f"{'shared':<12} {'pane':<9}{len(shared):>4} proc(s)  {total_mb(shared):>6} MB{srcnote}  "
          f"- under panes linked into more than one session; not attributed")
print(f"{'':<12} {'TOTAL':<9}{len(surplus):>4} proc(s)  {total_mb(surplus):>6} MB  surplus "
      f"[footprint: {source_of(surplus)}]")
print("  Counts are matching PROCESSES above --keep, not servers: a wrapper, its")
print("  child and its workers all match one needle, and a restart can recreate")
print("  exactly that. `wrapped` is a board label, not proof of inactivity.")
print("  Report only. Nothing here is killed: a connected MCP server that dies")
print("  loses its tools. Reclaim by restarting the session and resuming.")
PYEOF
