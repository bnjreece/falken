#!/usr/bin/env bash
# falken — Falken boot splash: amber-CRT "research terminal" (Concept 3 by Fable).
# Multi-color truecolor. rev = Falken repo commit count. reece.is/falken.
# Args: --quick (short, for session start), --loop, -h. bash 3.2 safe.
set -uo pipefail

# --- palette (24-bit truecolor) ---
A1=$'\033[38;5;214m'   # bright amber  (▸ arrows, chrome)  — 256-color, renders over WebSSH
A2=$'\033[38;5;172m'   # mid amber     (labels)
A3=$'\033[38;5;94m'    # dark amber    (░ static, rule)
GRN=$'\033[38;5;78m'   # forest green (results — fleet 'working')
CUR=$'\033[38;5;230m'  # soft cream cursor
W1=$'\033[38;5;78m'    # wordmark row 1 — forest (fleet working)   ┐
W2=$'\033[38;5;178m'   # wordmark row 2 — gold   (fleet done)      ├ "fleet jewel"
W3=$'\033[38;5;167m'   # wordmark row 3 — rose   (fleet needs)     ┘
RST=$'\033[0m'; DIM=$'\033[2m'
HIDE=$'\033[?25l'; SHOW=$'\033[?25h'; CLR=$'\033[2J\033[H'

# non-tty guard: plain line, no escapes
if [ ! -t 1 ]; then printf 'FALKEN · reece.is/falken — the falcon over your fleet\n'; exit 0; fi

quick=0; loop=0
for a in "$@"; do case "$a" in
  --quick) quick=1 ;; --loop) loop=1 ;;
  -h|--help) printf 'usage: falken [--quick] [--loop]\n'; exit 0 ;;
esac; done

cleanup(){ printf '%s' "$SHOW$RST"; }
trap cleanup EXIT; trap 'exit 130' INT; trap 'exit 143' TERM
printf '%s' "$HIDE"

# --- live bits: rev = commit count; flock counts from agent-state ---
rev=$(git -C "$HOME/bnjmn/falken" rev-list --count HEAD 2>/dev/null); [ -n "$rev" ] || rev=1
sdir="$HOME/.claude/agent-state"; aloft=0; rest=0
if [ -d "$sdir" ]; then
  for f in "$sdir"/*; do [ -e "$f" ] || continue
    case "$(cat "$f" 2>/dev/null)" in
      needs|working|done) aloft=$((aloft+1)) ;;
      idle|wrapped)       rest=$((rest+1)) ;;
    esac
  done
fi

band(){ printf ' %s░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░%s\n' "$A3" "$RST"; }
wm1(){  printf '   %s█▀▀▀ ▄▀▀▄ █    █ ▄▀ █▀▀▀ █▄ █%s\n' "$W1" "$RST"; }
wm2(){  printf '   %s█▀▀  █▀▀█ █    █▀▄  █▀▀  █ ▀█%s\n' "$W2" "$RST"; }
wm3(){  printf '   %s▀    ▀  ▀ ▀▀▀▀ ▀  ▀ ▀▀▀▀ ▀  ▀%s\n' "$W3" "$RST"; }
rule(){ printf '   %s▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔%s %s%sreece.is/falken%s\n' "$A3" "$RST" "$DIM" "$A2" "$RST"; }
head_(){ printf '  %s%sresearch terminal%s              %srev %s%s\n\n' "$DIM" "$A3" "$RST" "$A3" "$rev" "$RST"; }
ck(){ # label, result, [result-color]
  local lbl="$1" res="$2" col="${3:-$GRN}" pad="$1 "
  while [ ${#pad} -lt 22 ]; do pad="$pad."; done
  printf '   %s▸%s %s%s%s %s%s%s\n' "$A1" "$RST" "$A2" "$pad" "$RST" "$col" "$res" "$RST"
}

# render(wordmark rows 0-3, checklist lines 0-4, cursor 0/1)
render(){
  local w="$1" c="$2" cur="${3:-1}"
  printf '%s' "$CLR"; band; head_
  [ "$w" -ge 1 ] && wm1 || printf '\n'
  [ "$w" -ge 2 ] && wm2 || printf '\n'
  [ "$w" -ge 3 ] && wm3 || printf '\n'
  rule; printf '\n'
  [ "$c" -ge 1 ] && ck "waking up"           "hello"                        || printf '\n'
  [ "$c" -ge 2 ] && ck "your flock"          "$aloft aloft · $rest at rest" || printf '\n'
  [ "$c" -ge 3 ] && ck "keeping watch"       "always"                       || printf '\n'
  if   [ "$c" -ge 4 ] && [ "$cur" = 1 ]; then ck "here if you need me" "▊" "$CUR"
  elif [ "$c" -ge 4 ];                    then ck "here if you need me" " " "$CUR"
  else printf '\n'; fi
  band
}

# dissolve the whole frame to black over a few grey steps, then clear — so the
# handoff to whatever runs next (Claude Code) fades in from black, no flash.
fade_out(){
  local oA1="$A1" oA2="$A2" oA3="$A3" oW1="$W1" oW2="$W2" oW3="$W3" oGRN="$GRN" oCUR="$CUR"
  local s c
  for s in 240 238 236 234 232; do
    c=$'\033[38;5;'"$s"'m'
    A1="$c"; A2="$c"; A3="$c"; W1="$c"; W2="$c"; W3="$c"; GRN="$c"; CUR="$c"
    render 3 4 1; sleep 0.055
  done
  A1="$oA1"; A2="$oA2"; A3="$oA3"; W1="$oW1"; W2="$oW2"; W3="$oW3"; GRN="$oGRN"; CUR="$oCUR"
  printf '%s' "$CLR"; sleep 0.04                 # clean black; next thing draws over it
}

play(){
  if [ "$quick" = 1 ]; then
    render 0 0 0; sleep 0.05                      # CRT flick-on
    render 3 4 1; sleep 0.45                      # snap to full, brief hold
    fade_out; return
  fi
  render 0 0 0; sleep 0.06                        # power-on flicker...
  printf '%s' "$CLR"; sleep 0.05                  #   ...blink dark
  render 1 0 0; sleep 0.09
  render 2 0 0; sleep 0.09
  render 3 0 0; sleep 0.20                        # wordmark reveals
  render 3 1 0; sleep 0.16
  render 3 2 0; sleep 0.16
  render 3 3 0; sleep 0.16
  render 3 4 1; sleep 0.45                        # checklist typed on
  local i=0; while [ "$i" -lt 2 ]; do render 3 4 0; sleep 0.36; render 3 4 1; sleep 0.36; i=$((i+1)); done
  fade_out                                        # dissolve to black → smooth handoff
}

if [ "$loop" = 1 ]; then while :; do play; done; else play; fi
