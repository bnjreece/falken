#!/usr/bin/env bash
# tmux-state-sync — keep ~/.claude/agent-state aligned with live tmux sessions:
#   (1) seed a default 'idle' for any live session with no state file (complete inventory),
#   (2) prune state files whose session no longer exists (stops a stale ✋ pulsing the dot).
# Idempotent, safe to call every status refresh. Prints nothing.
# PERF: one tmux call + one python pass (was a per-file basename fork loop).
live=$(tmux list-sessions -F '#{session_name}' 2>/dev/null)
[ -n "$live" ] || exit 0                 # tmux not responding → do nothing (never mass-prune)
FALKEN_LIVE="$live" exec python3 <<'PY'
import os
d = os.path.expanduser("~/.claude/agent-state")
os.makedirs(d, exist_ok=True)
live = set(os.environ.get("FALKEN_LIVE", "").split())
for s in live:                           # seed idle for untracked live sessions (never clobbers real state)
    p = os.path.join(d, s)
    if not os.path.exists(p):
        try:
            open(p, "x").write("idle")
        except OSError:
            pass
try:                                     # prune files for dead sessions
    for name in os.listdir(d):
        if name not in live:
            try:
                os.remove(os.path.join(d, name))
            except OSError:
                pass
except OSError:
    pass
PY
